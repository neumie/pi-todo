{
  "name": "@neumie/pi-todo",
  "version": "0.1.0",
  "description": "A session-local, non-steering follow-up queue for Pi.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neumie/pi-todo.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "todo",
    "follow-up"
  ],
  "files": [
    "extensions",
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "test": "node --experimental-transform-types --test test/*.test.ts",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm run typecheck:test && npm test && npm run check:package"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-todo.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.1 <0.86.0",
    "@earendil-works/pi-coding-agent": ">=0.85.1 <0.86.0",
    "@earendil-works/pi-tui": ">=0.85.1 <0.86.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "22.19.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
